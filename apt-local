#!/bin/bash

# ==========================================
# KONFIGURASI UTAMA
# ==========================================
APT_LOCAL_VERSION="1.2.0" # Diperbarui: Fitur Resolusi Dependensi Otomatis

# ==========================================
# KONFIGURASI DIREKTORI, LOG, & WARNA
# ==========================================
LOCAL_DIR="$HOME/.local"
TEMP_DIR="$LOCAL_DIR/tmp/apt-local"
LOG_DIR="$LOCAL_DIR/var/logs"
LOG_FILE="$LOG_DIR/apt-local-install.log"
CONF_DIR="$LOCAL_DIR/etc/apt-local"
CONF_FILE="$CONF_DIR/apt-local.conf"
TRACKING_DIR="$LOCAL_DIR/var/lib/apt-local/deb-install"
CUSTOM_SOURCES="$CONF_DIR/sources.list"
LOCAL_LISTS="$LOCAL_DIR/var/lib/apt-local/lists"

# Kode Warna Terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' 

mkdir -p "$TEMP_DIR" "$LOG_DIR" "$CONF_DIR" "$TRACKING_DIR" "$LOCAL_LISTS"

# ==========================================
# FILE KONFIGURASI & SOURCES.LIST MODULAR
# ==========================================
if [ ! -f "$CONF_FILE" ]; then
    echo "# ==========================================" > "$CONF_FILE"
    echo "# FILE KONFIGURASI UTAMA APT-LOCAL" >> "$CONF_FILE"
    echo "# ==========================================" >> "$CONF_FILE"
    echo "" >> "$CONF_FILE"
    echo "# 1. Daftar Izin (Whitelist)" >> "$CONF_FILE"
    echo "# Gunakan tanda bintang (*) untuk mengizinkan instalasi semua paket," >> "$CONF_FILE"
    echo "# atau gunakan format array untuk izin spesifik, contoh: whitelist=[htop, nano, wget]" >> "$CONF_FILE"
    echo "whitelist=*" >> "$CONF_FILE"
    echo "" >> "$CONF_FILE"
    echo "# 2. Daftar Blokir (Blacklist)" >> "$CONF_FILE"
    echo "# Mencegah instalasi paket sistem inti yang bisa merusak OS utama." >> "$CONF_FILE"
    echo "# Berlaku bahkan jika whitelist diatur ke *" >> "$CONF_FILE"
    echo "blacklist=[gcc, g++, make, build-essential, libc6, libc-bin, systemd, init, linux-image-generic, linux-headers-generic, grub-pc, grub-efi, initramfs-tools, apt, dpkg, network-manager, netplan.io, openssh-server, ufw, iptables, docker.io, containerd, dbus, udev, xserver-xorg, xwayland, mesa-vulkan-drivers]" >> "$CONF_FILE"
fi

# Deteksi OS dan pembuatan Sources.list secara Modular
if [ ! -f "$CUSTOM_SOURCES" ]; then
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS_ID=$ID
        OS_CODENAME=$VERSION_CODENAME
    else
        OS_ID="ubuntu"
        OS_CODENAME="noble"
    fi

    # Penanganan untuk distro turunan Ubuntu (Linux Mint, Pop!_OS, Zorin, dll)
    if [ -n "$UBUNTU_CODENAME" ]; then
        OS_CODENAME=$UBUNTU_CODENAME
        OS_ID="ubuntu"
    fi

    case "$OS_ID" in
        debian)
            REPO_URL="http://deb.debian.org/debian/"
            COMPONENTS="main contrib non-free non-free-firmware"
            ;;
        ubuntu|*)
            REPO_URL="http://archive.ubuntu.com/ubuntu/"
            COMPONENTS="main restricted universe multiverse"
            ;;
    esac

    echo "deb $REPO_URL $OS_CODENAME $COMPONENTS" > "$CUSTOM_SOURCES"
fi

log_message() {
    local TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
    echo "[$TIMESTAMP] $1" >> "$LOG_FILE"
}

# ==========================================
# FUNGSI ANIMASI SPINNER (LOADING BAR)
# ==========================================
spinner() {
    local pid=$1
    local message=$2
    local delay=0.1
    local spinstr='\|/-'
    
    tput civis
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf "\r\033[K%s [%c]" "$message" "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
    done
    tput cnorm
    printf "\r\033[K"
}

# ==========================================
# PENGECEKAN ARGUMEN & PERINTAH
# ==========================================
COMMAND=$1
shift 
PACKAGES=("$@")

if [ -z "$COMMAND" ]; then
    echo -e "${CYAN}Penggunaan yang benar:${NC}"
    echo "  apt-local update"
    echo "  apt-local search  <kata_kunci>"
    echo "  apt-local install <paket1> <paket2> ..."
    echo "  apt-local remove  <paket1> <paket2> ..."
    echo "  apt-local list"
    echo "  apt-local list --installed"
    echo "  apt-local env"
    echo "Ketik ${YELLOW}apt-local help${NC} untuk melihat panduan lengkap."
    exit 1
fi

# ==========================================
# BLOK PERINTAH: VERSION
# ==========================================
if [ "$COMMAND" == "version" ] || [ "$COMMAND" == "-v" ] || [ "$COMMAND" == "--version" ]; then
    echo -e "apt-local versi ${GREEN}${APT_LOCAL_VERSION}${NC}"
    exit 0
fi

# ==========================================
# BLOK PERINTAH: HELP
# ==========================================
if [ "$COMMAND" == "help" ] || [ "$COMMAND" == "-h" ] || [ "$COMMAND" == "--help" ]; then
    echo -e "${CYAN}==================================================${NC}"
    echo -e "📖 PANDUAN PENGGUNAAN APT-LOCAL (v${APT_LOCAL_VERSION})"
    echo -e "${CYAN}==================================================${NC}"
    echo -e "apt-local adalah skrip pengelola paket untuk menginstal aplikasi"
    echo -e "Debian (.deb) secara lokal di folder (~/.local) tanpa akses root.\n"
    
    echo -e "${YELLOW}Perintah yang Tersedia:${NC}"
    echo -e "  ${GREEN}update${NC}   : Memperbarui daftar paket dari repositori sistem."
    echo -e "  ${GREEN}search${NC}   : Mencari paket yang tersedia berdasarkan kata kunci."
    echo -e "  ${GREEN}install${NC}  : Mengunduh dan memasang paket (beserta dependensinya)."
    echo -e "             Contoh: ${CYAN}apt-local install htop nano${NC}"
    echo -e "  ${GREEN}remove${NC}   : Menghapus paket yang sebelumnya diinstal oleh apt-local."
    echo -e "  ${GREEN}list${NC}     : Menampilkan semua daftar paket dari repositori."
    echo -e "             Gunakan ${CYAN}apt-local list --installed${NC} untuk paket lokal."
    echo -e "  ${GREEN}env${NC}      : Mengecek dan mengonfigurasi Environment Variable (\$PATH)."
    echo -e "  ${GREEN}version${NC}  : Menampilkan versi apt-local saat ini. (-v, --version)"
    echo -e "  ${GREEN}help${NC}     : Menampilkan halaman panduan ini. (-h, --help)"
    
    echo -e "\n${YELLOW}Catatan:${NC}"
    echo -e "Konfigurasi whitelist/blacklist berada di: ${CYAN}~/.local/etc/apt-local/apt-local.conf${NC}"
    echo -e "${CYAN}==================================================${NC}"
    exit 0
fi

# ==========================================
# BLOK PERINTAH: ENV
# ==========================================
if [ "$COMMAND" == "env" ]; then
    echo -e "${CYAN}==================================================${NC}"
    echo -e "🔍 Mengecek Environment Variables untuk ~/.local"
    echo -e "${CYAN}==================================================${NC}"

    T_PATH_1="$HOME/.local/bin"
    T_PATH_2="$HOME/.local/usr/bin"
    T_LIB="$HOME/.local/usr/lib"
    T_SHARE="$HOME/.local/usr/share"

    MISSING_VARS=0

    echo -e "\n${YELLOW}1. Status Sesi Saat Ini (Active Environment):${NC}"
    
    if [[ ":$PATH:" == *":$T_PATH_1:"* ]] || [[ ":$PATH:" == *":$T_PATH_2:"* ]]; then
        echo -e "   - \$PATH             : ${GREEN}✅ OK${NC}"
    else
        echo -e "   - \$PATH             : ${RED}❌ MISSING${NC}"
        MISSING_VARS=1
    fi

    if [[ ":$LD_LIBRARY_PATH:" == *":$T_LIB:"* ]]; then
        echo -e "   - \$LD_LIBRARY_PATH  : ${GREEN}✅ OK${NC}"
    else
        echo -e "   - \$LD_LIBRARY_PATH  : ${RED}❌ MISSING${NC}"
        MISSING_VARS=1
    fi

    if [[ ":$XDG_DATA_DIRS:" == *":$T_SHARE:"* ]]; then
        echo -e "   - \$XDG_DATA_DIRS    : ${GREEN}✅ OK${NC}"
    else
        echo -e "   - \$XDG_DATA_DIRS    : ${RED}❌ MISSING${NC}"
        MISSING_VARS=1
    fi

    if [ $MISSING_VARS -eq 1 ]; then
        echo -e "\n${RED}⚠️  PERINGATAN: Environment belum lengkap!${NC}"
        echo -e "Variabel berikut diperlukan untuk menjalankan aplikasi lokal:"
        echo -e "${CYAN}--------------------------------------------------${NC}"
        echo 'export PATH="$HOME/.local/bin:$HOME/.local/usr/bin:$PATH"'
        echo 'export LD_LIBRARY_PATH="$HOME/.local/usr/lib:$HOME/.local/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"'
        echo 'export XDG_DATA_DIRS="$HOME/.local/usr/share:$XDG_DATA_DIRS"'
        echo -e "${CYAN}--------------------------------------------------${NC}"
        
        read -p "❓ Apakah Anda mau memasukkan variabel environment ini ke ~/.bashrc secara otomatis? [Y/n] " ADD_ENV
        
        if [[ "$ADD_ENV" =~ ^[Yy]$ ]] || [[ -z "$ADD_ENV" ]]; then
            echo "" >> "$HOME/.bashrc"
            echo "# Environment otomatis oleh apt-local" >> "$HOME/.bashrc"
            echo 'export PATH="$HOME/.local/bin:$HOME/.local/usr/bin:$PATH"' >> "$HOME/.bashrc"
            echo 'export LD_LIBRARY_PATH="$HOME/.local/usr/lib:$HOME/.local/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"' >> "$HOME/.bashrc"
            echo 'export XDG_DATA_DIRS="$HOME/.local/usr/share:$XDG_DATA_DIRS"' >> "$HOME/.bashrc"
            
            echo -e "${GREEN}✅ Konfigurasi berhasil ditambahkan ke bagian bawah ~/.bashrc!${NC}"
            echo -e "Silakan jalankan perintah ${YELLOW}source ~/.bashrc${NC} atau buka ulang terminal Anda agar pengaturan aktif."
        else
            echo "❌ Dibatalkan. Anda bisa menyalin teks biru di atas dan menambahkannya secara manual nanti."
        fi
    else
        echo -e "\n${GREEN}🎉 Semua environment telah dikonfigurasi dengan sempurna!${NC}"
    fi
    exit 0

# ==========================================
# BLOK PERINTAH: UPDATE
# ==========================================
elif [ "$COMMAND" == "update" ]; then
    echo "🔄 Memperbarui daftar paket dari sumber lokal..."
    apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
        -o Dir::Etc::sourceparts="-" \
        -o Dir::State::Lists="$LOCAL_LISTS" \
        update > /dev/null 2>> "$LOG_FILE" &
    
    UPDATE_PID=$!
    spinner $UPDATE_PID "Membaca daftar paket terbaru..."
    wait $UPDATE_PID
    
    echo "✅ Berhasil memperbarui daftar paket."
    exit 0

# ==========================================
# BLOK PERINTAH: SEARCH (Revisi)
# ==========================================
elif [ "$COMMAND" == "search" ]; then
    if [ ${#PACKAGES[@]} -eq 0 ]; then
        echo -e "${RED}❌ Harap masukkan kata kunci pencarian.${NC}"
        exit 1
    fi
    
    KEYWORD="${PACKAGES[*]}"
    echo "🔍 Mencari paket dengan kata kunci: '$KEYWORD'..."
    echo -e "${CYAN}--------------------------------------------------${NC}"
    
    # Menggunakan 'apt search' (bukan apt-cache) untuk output multi-baris
    # Menyertakan repo, versi, arsitektur, dan deskripsi di baris bawahnya.
    # sed digunakan untuk membersihkan teks bawaan "Sorting..." dan "Full Text Search..."
    apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
        -o Dir::Etc::sourceparts="-" \
        -o Dir::State::Lists="$LOCAL_LISTS" \
        search "$KEYWORD" 2>/dev/null | sed -e '/^Sorting/d' -e '/^Full Text Search/d'
              
    echo -e "${CYAN}--------------------------------------------------${NC}"
    exit 0

# ==========================================
# BLOK PERINTAH: LIST
# ==========================================
elif [ "$COMMAND" == "list" ]; then
    if [ "${PACKAGES[0]}" == "--installed" ]; then
        if [ -z "$(ls -A "$TRACKING_DIR"/*.conf 2>/dev/null)" ]; then
            echo "📭 Belum ada paket yang terinstal."
            exit 0
        fi
        echo "📦 Daftar Paket apt-local Terinstal:"
        echo "--------------------------------------------------"
        for conf_file in "$TRACKING_DIR"/*.conf; do
            NAMA=$(grep "^nama_paket:" "$conf_file" | sed 's/nama_paket: //')
            VERSI=$(grep "^versi:" "$conf_file" | sed 's/versi: //')
            echo " - $NAMA (Versi: $VERSI)"
        done
        echo "--------------------------------------------------"
        exit 0
    else
        echo "📜 Mengambil daftar semua paket dari repositori..."
        echo -e "${YELLOW}Catatan: Anda dapat menggunakan 'apt-local list | less' atau 'grep' untuk mencari.${NC}"
        echo -e "${CYAN}--------------------------------------------------${NC}"
        
        apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
            -o Dir::Etc::sourceparts="-" \
            -o Dir::State::Lists="$LOCAL_LISTS" \
            list 2>/dev/null
            
        exit 0
    fi

# ==========================================
# BLOK PERINTAH: INSTALL
# ==========================================
elif [ "$COMMAND" == "install" ]; then
    if [ ${#PACKAGES[@]} -eq 0 ]; then
        echo "❌ Harap masukkan nama paket."
        exit 1
    fi

    log_message "=================================================="
    log_message "🚀 Memulai pra-instalasi untuk: ${PACKAGES[*]}"

    SESSION_DIR=$(mktemp -d "$TEMP_DIR/session_XXXXXX")
    cd "$SESSION_DIR" || exit 1

    declare -a VALID_DEBS
    declare -a VALID_PKGS

    echo -e "${CYAN}🔍 Menganalisis paket dan dependensi yang dibutuhkan...${NC}"
    
    # ---------------------------------------------------------
    # FASE 0: RESOLUSI DEPENDENSI (DEPENDENCY CHECKING)
    # ---------------------------------------------------------
    # Menggunakan apt-get -s (simulate) untuk melihat apa yang akan diinstal.
    # Ini akan secara cerdas mengabaikan dependensi yang sudah terinstal di OS Host utama Anda.
    SIMULATION=$(apt-get -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
            -o Dir::Etc::sourceparts="-" \
            -o Dir::State::Lists="$LOCAL_LISTS" \
            -s install "${PACKAGES[@]}" 2>/dev/null)
            
    # Ambil baris yang dimulai dengan "Inst" dan ekstrak nama paketnya di kolom kedua
    RESOLVED_PACKAGES=($(echo "$SIMULATION" | grep "^Inst " | awk '{print $2}'))
    
    if [ ${#RESOLVED_PACKAGES[@]} -eq 0 ]; then
        # Jika array kosong, fallback menggunakan paket asli (bisa jadi paket sudah ada di host
        # tapi user memaksa ingin menginstalnya di lingkungan lokal)
        RESOLVED_PACKAGES=("${PACKAGES[@]}")
    else
        echo -e "${GREEN}✅ Ditemukan total ${#RESOLVED_PACKAGES[@]} paket (termasuk dependensi).${NC}"
    fi

    echo "🔍 Menerapkan filter aturan (Whitelist & Blacklist)..."

    # ---------------------------------------------------------
    # FASE 1: FILTERING & UNDUH PAKET
    # ---------------------------------------------------------
    for PACKAGE_NAME in "${RESOLVED_PACKAGES[@]}"; do
        
        # --- ATURAN 1: WHITELIST ---
        WHITELIST_LINE=$(grep "^whitelist=" "$CONF_FILE" | head -n 1 | sed 's/whitelist=//' | xargs)
        
        if [ "$WHITELIST_LINE" != "*" ]; then
            WHITELIST_ITEMS=$(echo "$WHITELIST_LINE" | sed -n 's/.*\[\(.*\)\].*/\1/p')
            IFS=',' read -r -a whitelist_array <<< "$WHITELIST_ITEMS"
            
            IS_ALLOWED=0
            for app in "${whitelist_array[@]}"; do
                app_clean=$(echo "$app" | xargs)
                if [ "$app_clean" == "$PACKAGE_NAME" ]; then
                    IS_ALLOWED=1
                    break
                fi
            done
            
            if [ $IS_ALLOWED -eq 0 ]; then
                echo -e "${YELLOW}⛔ DITOLAK: Paket '$PACKAGE_NAME' (mungkin dependensi) tidak diizinkan oleh opsi 'whitelist' di $CONF_FILE.${NC}"
                continue
            fi
        fi

        # --- ATURAN 2: BLACKLIST ---
        # Sangat penting agar dependensi tidak secara tidak sengaja menarik komponen inti OS (seperti libc6) ke ~/.local
        BLACKLIST_LINE=$(grep "^blacklist=" "$CONF_FILE" | head -n 1)
        if [ -n "$BLACKLIST_LINE" ]; then
            BLACKLIST_ITEMS=$(echo "$BLACKLIST_LINE" | sed -n 's/.*\[\(.*\)\].*/\1/p')
            IFS=',' read -r -a blacklist_array <<< "$BLACKLIST_ITEMS"
            
            IS_BLACKLISTED=0
            for app in "${blacklist_array[@]}"; do
                app_clean=$(echo "$app" | xargs)
                if [ "$app_clean" == "$PACKAGE_NAME" ]; then
                    echo -e "${RED}🚫 BLOKIR: Paket '$PACKAGE_NAME' berbahaya dan dilarang (blacklist) di $CONF_FILE.${NC}"
                    IS_BLACKLISTED=1
                    break
                fi
            done
            if [ $IS_BLACKLISTED -eq 1 ]; then continue; fi
        fi

        # --- UNDUH ---
        apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
            -o Dir::Etc::sourceparts="-" \
            -o Dir::State::Lists="$LOCAL_LISTS" \
            download "$PACKAGE_NAME" > /dev/null 2>> "$LOG_FILE" &
            
        DL_PID=$!
        spinner $DL_PID "⬇️  Mengunduh paket: $PACKAGE_NAME"
        wait $DL_PID
        
        if [ $? -ne 0 ]; then
            echo -e "${YELLOW}⚠️ Gagal mengunduh '$PACKAGE_NAME'. (Pastikan sudah apt-local update).${NC}"
            continue
        fi

        DEB_FILE=$(ls -t ${PACKAGE_NAME}_*.deb 2>/dev/null | head -n 1)
        if [ -z "$DEB_FILE" ]; then
             DEB_FILE=$(ls -t *.deb 2>/dev/null | head -n 1)
        fi

        if [ -n "$DEB_FILE" ]; then
            VALID_DEBS+=("$DEB_FILE")
            VALID_PKGS+=("$PACKAGE_NAME")
            mv "$DEB_FILE" "${PACKAGE_NAME}_staged.deb"
            VALID_DEBS[$(( ${#VALID_DEBS[@]} - 1 ))]="${PACKAGE_NAME}_staged.deb"
        fi
    done

    if [ ${#VALID_DEBS[@]} -eq 0 ]; then
        echo "❌ Tidak ada paket valid yang dapat diproses."
        rm -rf "$SESSION_DIR"
        exit 1
    fi

    # ---------------------------------------------------------
    # FASE 2: MENAMPILKAN RINGKASAN
    # ---------------------------------------------------------
    echo ""
    echo -e "${CYAN}==================================================${NC}"
    echo "📦 RINGKASAN RENCANA INSTALASI"
    echo -e "${CYAN}==================================================${NC}"
    
    for i in "${!VALID_PKGS[@]}"; do
        PKG="${VALID_PKGS[$i]}"
        DEB="${VALID_DEBS[$i]}"
        
        VERSION=$(dpkg-deb -f "$DEB" Version)
        RAW_PATHS=$(dpkg-deb -c "$DEB" | awk '$1 !~ /^d/ {print $6}' | sed "s|^\.|$LOCAL_DIR|")
        FILE_COUNT=$(echo "$RAW_PATHS" | wc -l)
        
        echo "$((i+1)). Nama Paket  : $PKG"
        echo "   Versi       : $VERSION"
        echo "   Jumlah File : $FILE_COUNT file akan dipasang"
        echo "   Lokasi File (Detail):"
        
        echo "$RAW_PATHS" | head -n 3 | while read -r path_line; do
            if [ -e "$path_line" ] || [ -L "$path_line" ]; then
                echo -e "     - ${RED}$path_line (menimpa)${NC}"
            else
                echo "     - $path_line"
            fi
        done
        
        if [ "$FILE_COUNT" -gt 3 ]; then
            REMAINING=$((FILE_COUNT - 3))
            echo "     ... (dan $REMAINING file lainnya tidak ditampilkan)"
        fi
        echo ""
    done
    echo -e "${CYAN}==================================================${NC}"
    
    read -p "❓ Apakah Anda setuju untuk menginstal ${#VALID_PKGS[@]} paket (termasuk dependensi) ke lokal? [Y/n] " CONFIRM
    
    if [[ "$CONFIRM" =~ ^[Yy]$ ]] || [[ -z "$CONFIRM" ]]; then
        echo ""
        log_message "✅ Persetujuan diberikan oleh user."
        
        # ---------------------------------------------------------
        # FASE 3: EKSTRAKSI & TRACKING
        # ---------------------------------------------------------
        for i in "${!VALID_PKGS[@]}"; do
            PKG="${VALID_PKGS[$i]}"
            DEB="${VALID_DEBS[$i]}"
            
            dpkg -x "$DEB" "$LOCAL_DIR/" > /dev/null 2>> "$LOG_FILE" &
            EXTRACT_PID=$!
            
            spinner $EXTRACT_PID "📦 Mengekstrak dan menyalin: $PKG"
            wait $EXTRACT_PID
            
            if [ $? -eq 0 ]; then
                VERSION=$(dpkg-deb -f "$DEB" Version)
                FORMATTED_PATHS=$(dpkg-deb -c "$DEB" | awk '$1 !~ /^d/ {print $6}' | sed "s|^\.|$LOCAL_DIR|" | paste -sd ',' -)
                
                TRACK_FILE="$TRACKING_DIR/${PKG}.conf"
                echo "nama_paket: $PKG" > "$TRACK_FILE"
                echo "versi: $VERSION" >> "$TRACK_FILE"
                echo "path: [$FORMATTED_PATHS]" >> "$TRACK_FILE"
                
                echo -e "${GREEN}✅ Paket '$PKG' berhasil diinstal.${NC}"
                log_message "✅ Paket '$PKG' berhasil diinstal."
            else
                echo -e "${RED}❌ Gagal mengekstrak '$PKG'.${NC}"
            fi
        done
        echo "🎉 Proses instalasi selesai!"
    else
        echo "❌ Instalasi dibatalkan oleh Anda."
        log_message "Instalasi dibatalkan oleh pengguna."
    fi

    rm -rf "$SESSION_DIR"
    exit 0

# ==========================================
# BLOK PERINTAH: REMOVE
# ==========================================
elif [ "$COMMAND" == "remove" ]; then
    if [ ${#PACKAGES[@]} -eq 0 ]; then
        echo "❌ Harap masukkan nama paket."
        exit 1
    fi

    for PKG in "${PACKAGES[@]}"; do
        TRACK_FILE="$TRACKING_DIR/${PKG}.conf"

        if [ ! -f "$TRACK_FILE" ]; then
            echo -e "${YELLOW}⚠️ Paket '$PKG' tidak ditemukan dalam catatan lokal. Dilewati.${NC}"
            continue
        fi
        
        (
            PATHS_LINE=$(grep "^path:" "$TRACK_FILE" | head -n 1)
            PATHS_CSV=$(echo "$PATHS_LINE" | sed -n 's/.*\[\(.*\)\].*/\1/p')
            IFS=',' read -r -a paths_array <<< "$PATHS_CSV"

            for file_path in "${paths_array[@]}"; do
                if [ -f "$file_path" ] || [ -L "$file_path" ]; then
                    rm -f "$file_path"
                fi
            done
            rm -f "$TRACK_FILE"
        ) &
        
        RM_PID=$!
        spinner $RM_PID "🗑️ Menghapus $PKG dan membersihkan sistem..."
        wait $RM_PID
        
        echo -e "${GREEN}✅ $PKG berhasil dihapus sepenuhnya.${NC}"
    done
    exit 0

else
    echo -e "${RED}❌ Perintah '$COMMAND' tidak dikenali.${NC}"
    exit 1
fi