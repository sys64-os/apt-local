#!/bin/bash

# ==========================================
# KONFIGURASI UTAMA
# ==========================================
APT_LOCAL_VERSION="0.0.08-beta" # Diperbarui: Tweak App-Specific (Perbaikan Nano rcfile)

# ==========================================
# KONFIGURASI DIREKTORI, LOG, & WARNA
# ==========================================
LOCAL_DIR="$HOME/.local"
TEMP_DIR="$LOCAL_DIR/tmp/apt-local"
POST_INSTALL_DIR="$TEMP_DIR/post-install"
LOG_DIR="$LOCAL_DIR/var/logs"
LOG_FILE="$LOG_DIR/apt-local-install.log"
CONF_DIR="$LOCAL_DIR/etc/apt-local"
CONF_FILE="$CONF_DIR/apt-local.conf"
TRACKING_DIR="$LOCAL_DIR/var/lib/apt-local/deb-install"
CUSTOM_SOURCES="$CONF_DIR/sources.list"
LOCAL_LISTS="$LOCAL_DIR/var/lib/apt-local/lists"

# Kode Warna Terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' 

mkdir -p "$TEMP_DIR" "$LOG_DIR" "$CONF_DIR" "$TRACKING_DIR" "$LOCAL_LISTS" "$POST_INSTALL_DIR"

# ==========================================
# FILE KONFIGURASI & SOURCES.LIST MODULAR
# ==========================================
if [ ! -f "$CONF_FILE" ]; then
    echo "# ==========================================" > "$CONF_FILE"
    echo "# FILE KONFIGURASI UTAMA APT-LOCAL" >> "$CONF_FILE"
    echo "# ==========================================" >> "$CONF_FILE"
    echo "" >> "$CONF_FILE"
    echo "# 1. Daftar Izin (Whitelist)" >> "$CONF_FILE"
    echo "# Gunakan tanda bintang (*) untuk mengizinkan instalasi semua paket," >> "$CONF_FILE"
    echo "# atau gunakan format array untuk izin spesifik, contoh: whitelist=[htop, nano, wget]" >> "$CONF_FILE"
    echo "whitelist=*" >> "$CONF_FILE"
    echo "" >> "$CONF_FILE"
    echo "# 2. Daftar Blokir (Blacklist)" >> "$CONF_FILE"
    echo "# Mencegah instalasi paket sistem inti yang bisa merusak OS utama." >> "$CONF_FILE"
    echo "# Berlaku bahkan jika whitelist diatur ke *" >> "$CONF_FILE"
    echo "blacklist=[gcc, g++, make, build-essential, libc6, libc-bin, systemd, init, linux-image-generic, linux-headers-generic, grub-pc, grub-efi, initramfs-tools, apt, dpkg, network-manager, netplan.io, openssh-server, ufw, iptables, docker.io, containerd, dbus, udev, xserver-xorg, xwayland, mesa-vulkan-drivers]" >> "$CONF_FILE"
fi

if [ ! -f "$CUSTOM_SOURCES" ]; then
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS_ID=$ID
        OS_CODENAME=$VERSION_CODENAME
    else
        OS_ID="ubuntu"
        OS_CODENAME="noble"
    fi

    if [ -n "$UBUNTU_CODENAME" ]; then
        OS_CODENAME=$UBUNTU_CODENAME
        OS_ID="ubuntu"
    fi

    case "$OS_ID" in
        debian)
            REPO_URL="http://deb.debian.org/debian/"
            COMPONENTS="main contrib non-free non-free-firmware"
            ;;
        ubuntu|*)
            REPO_URL="http://archive.ubuntu.com/ubuntu/"
            COMPONENTS="main restricted universe multiverse"
            ;;
    esac

    echo "deb $REPO_URL $OS_CODENAME $COMPONENTS" > "$CUSTOM_SOURCES"
fi

log_message() {
    local TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
    echo "[$TIMESTAMP] $1" >> "$LOG_FILE"
}

# ==========================================
# FUNGSI ANIMASI SPINNER (LOADING BAR)
# ==========================================
spinner() {
    local pid=$1
    local message=$2
    local delay=0.1
    local spinstr='\|/-'
    
    tput civis
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf "\r\033[K%s [%c]" "$message" "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
    done
    tput cnorm
    printf "\r\033[K"
}

# ==========================================
# PENGECEKAN ARGUMEN & PERINTAH
# ==========================================
COMMAND=$1
shift 
PACKAGES=("$@")

if [ -z "$COMMAND" ]; then
    echo -e "${CYAN}Penggunaan yang benar:${NC}"
    echo "  apt-local update"
    echo "  apt-local search  <kata_kunci>"
    echo "  apt-local install [--dry-run] <paket1> <paket2> ..."
    echo "  apt-local remove  <paket1> <paket2> ..."
    echo "  apt-local reset"
    echo "  apt-local list"
    echo "  apt-local list --installed"
    echo "  apt-local env"
    echo "Ketik ${GREEN}apt-local help${NC} untuk melihat panduan lengkap."
    exit 1
fi

if [ "$COMMAND" == "version" ] || [ "$COMMAND" == "-v" ] || [ "$COMMAND" == "--version" ]; then
    echo -e "apt-local versi ${GREEN}${APT_LOCAL_VERSION}${NC}"
    exit 0
fi

if [ "$COMMAND" == "help" ] || [ "$COMMAND" == "-h" ] || [ "$COMMAND" == "--help" ]; then
    echo -e "${CYAN}==================================================${NC}"
    echo -e "📖 PANDUAN PENGGUNAAN APT-LOCAL (v${APT_LOCAL_VERSION})"
    echo -e "${CYAN}==================================================${NC}"
    echo -e "apt-local adalah skrip pengelola paket untuk menginstal aplikasi"
    echo -e "Debian (.deb) secara lokal di folder (~/.local) tanpa akses root.\n"
    
    echo -e "${YELLOW}Perintah yang Tersedia:${NC}"
    echo -e "  ${GREEN}update${NC}   : Memperbarui daftar paket dari repositori sistem."
    echo -e "  ${GREEN}search${NC}   : Mencari paket yang tersedia berdasarkan kata kunci."
    echo -e "  ${GREEN}install${NC}  : Mengunduh dan memasang paket (beserta dependensinya)."
    echo -e "             Tambahkan ${CYAN}--dry-run${NC} untuk simulasi tanpa modifikasi sistem."
    echo -e "  ${GREEN}remove${NC}   : Menghapus paket (mendukung autoremove dependensi)."
    echo -e "  ${GREEN}reset${NC}    : Menghapus SELURUH aplikasi yang diinstal melalui apt-local."
    echo -e "  ${GREEN}list${NC}     : Menampilkan daftar paket dari repositori / terinstal."
    echo -e "  ${GREEN}env${NC}      : Mengecek dan mengonfigurasi Environment Variable (\$PATH)."
    echo -e "  ${GREEN}version${NC}  : Menampilkan versi apt-local saat ini. (-v, --version)"
    echo -e "  ${GREEN}help${NC}     : Menampilkan halaman panduan ini. (-h, --help)"
    exit 0
fi

if [ "$COMMAND" == "env" ]; then
    echo -e "Gunakan apt-local env dari versi sebelumnya jika butuh fungsi ini."
    exit 0
fi

if [ "$COMMAND" == "update" ]; then
    echo "🔄 Memperbarui daftar paket dari sumber lokal..."
    apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
        -o Dir::Etc::sourceparts="-" \
        -o Dir::State::Lists="$LOCAL_LISTS" \
        update > /dev/null 2>> "$LOG_FILE" &
    
    UPDATE_PID=$!
    spinner $UPDATE_PID "Membaca daftar paket terbaru..."
    wait $UPDATE_PID
    
    echo "✅ Berhasil memperbarui daftar paket."
    exit 0
fi

if [ "$COMMAND" == "search" ]; then
    if [ ${#PACKAGES[@]} -eq 0 ]; then
        echo -e "${RED}❌ Harap masukkan kata kunci pencarian.${NC}"
        exit 1
    fi
    KEYWORD="${PACKAGES[*]}"
    echo "🔍 Mencari paket dengan kata kunci: '$KEYWORD'..."
    apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
        -o Dir::Etc::sourceparts="-" \
        -o Dir::State::Lists="$LOCAL_LISTS" \
        search "$KEYWORD" 2>/dev/null | sed -e '/^Sorting/d' -e '/^Full Text Search/d'
    exit 0
fi

if [ "$COMMAND" == "list" ]; then
    if [ "${PACKAGES[0]}" == "--installed" ]; then
        if [ -z "$(ls -A "$TRACKING_DIR"/*.conf 2>/dev/null)" ]; then
            echo "📭 Belum ada paket yang terinstal."
            exit 0
        fi
        echo "📦 Daftar Paket apt-local Terinstal:"
        for conf_file in "$TRACKING_DIR"/*.conf; do
            NAMA=$(grep "^nama_paket:" "$conf_file" | sed 's/nama_paket: //')
            VERSI=$(grep "^versi:" "$conf_file" | sed 's/versi: //')
            TIPE=$(grep "^tipe:" "$conf_file" | sed 's/tipe: //')
            echo " - $NAMA (Versi: $VERSI) [Tipe: $TIPE]"
        done
        exit 0
    else
        echo "📜 Mengambil daftar semua paket dari repositori..."
        apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
            -o Dir::Etc::sourceparts="-" \
            -o Dir::State::Lists="$LOCAL_LISTS" \
            list 2>/dev/null
        exit 0
    fi
fi

# ==========================================
# BLOK PERINTAH: INSTALL
# ==========================================
if [ "$COMMAND" == "install" ]; then
    DRY_RUN=0
    declare -a FILTERED_PACKAGES
    
    for pkg in "${PACKAGES[@]}"; do
        if [[ "$pkg" == "--dryrun" || "$pkg" == "--dry-run" || "$pkg" == "-s" ]]; then
            DRY_RUN=1
        else
            FILTERED_PACKAGES+=("$pkg")
        fi
    done
    PACKAGES=("${FILTERED_PACKAGES[@]}")

    if [ ${#PACKAGES[@]} -eq 0 ]; then
        echo "❌ Harap masukkan nama paket yang ingin diinstal."
        exit 1
    fi

    if [ $DRY_RUN -eq 1 ]; then
        echo -e "${YELLOW}🛠️  MODE DRY-RUN AKTIF: Hanya simulasi, tidak ada file yang akan diubah.${NC}"
    fi

    log_message "🚀 Memulai pra-instalasi untuk: ${PACKAGES[*]}"

    SESSION_DIR=$(mktemp -d "$TEMP_DIR/session_XXXXXX")
    cd "$SESSION_DIR" || exit 1

    declare -a VALID_DEBS
    declare -a VALID_PKGS

    echo -e "${CYAN}🔍 Menganalisis dependensi paket...${NC}"
    
    SIMULATION=$(apt-get -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
            -o Dir::Etc::sourceparts="-" \
            -o Dir::State::Lists="$LOCAL_LISTS" \
            -s install "${PACKAGES[@]}" 2>/dev/null)
            
    RESOLVED_PACKAGES=($(echo "$SIMULATION" | grep "^Inst " | awk '{print $2}'))
    
    if [ ${#RESOLVED_PACKAGES[@]} -eq 0 ]; then
        RESOLVED_PACKAGES=("${PACKAGES[@]}")
    else
        echo -e "${GREEN}✅ Ditemukan total ${#RESOLVED_PACKAGES[@]} paket (termasuk dependensi otomatis).${NC}"
    fi

    for PACKAGE_NAME in "${RESOLVED_PACKAGES[@]}"; do
        BLACKLIST_LINE=$(grep "^blacklist=" "$CONF_FILE" | head -n 1)
        if [ -n "$BLACKLIST_LINE" ]; then
            BLACKLIST_ITEMS=$(echo "$BLACKLIST_LINE" | sed -n 's/.*\[\(.*\)\].*/\1/p')
            IFS=',' read -r -a blacklist_array <<< "$BLACKLIST_ITEMS"
            IS_BLACKLISTED=0
            for app in "${blacklist_array[@]}"; do
                app_clean=$(echo "$app" | xargs)
                if [ "$app_clean" == "$PACKAGE_NAME" ]; then
                    IS_BLACKLISTED=1
                    break
                fi
            done
            if [ $IS_BLACKLISTED -eq 1 ]; then continue; fi
        fi

        apt -o Dir::Etc::sourcelist="$CUSTOM_SOURCES" \
            -o Dir::Etc::sourceparts="-" \
            -o Dir::State::Lists="$LOCAL_LISTS" \
            download "$PACKAGE_NAME" > /dev/null 2>> "$LOG_FILE" &
            
        DL_PID=$!
        spinner $DL_PID "⬇️  Mengunduh paket: $PACKAGE_NAME"
        wait $DL_PID
        
        DEB_FILE=$(ls -t ${PACKAGE_NAME}_*.deb 2>/dev/null | head -n 1)
        if [ -z "$DEB_FILE" ]; then
             DEB_FILE=$(ls -t *.deb 2>/dev/null | head -n 1)
        fi

        if [ -n "$DEB_FILE" ]; then
            VALID_DEBS+=("$DEB_FILE")
            VALID_PKGS+=("$PACKAGE_NAME")
            mv "$DEB_FILE" "${PACKAGE_NAME}_staged.deb"
            VALID_DEBS[$(( ${#VALID_DEBS[@]} - 1 ))]="${PACKAGE_NAME}_staged.deb"
        fi
    done

    if [ ${#VALID_DEBS[@]} -eq 0 ]; then
        echo "❌ Tidak ada paket valid yang dapat diproses."
        rm -rf "$SESSION_DIR"
        exit 1
    fi

    # ==========================================
    # OUTPUT SIMULASI ATAU RINGKASAN
    # ==========================================
    echo -e "\n${CYAN}==================================================${NC}"
    echo "📦 RINGKASAN PAKET YANG AKAN DIPROSES"
    echo -e "${CYAN}==================================================${NC}"
    
    TOTAL_FILES=0
    for i in "${!VALID_PKGS[@]}"; do
        PKG="${VALID_PKGS[$i]}"
        DEB="${VALID_DEBS[$i]}"
        
        VERSION=$(dpkg-deb -f "$DEB" Version)
        RAW_PATHS=$(dpkg-deb -c "$DEB" | awk '$1 !~ /^d/ {print $6}' | sed "s|^\.|${LOCAL_DIR}|")
        FILE_COUNT=$(echo "$RAW_PATHS" | wc -l)
        TOTAL_FILES=$((TOTAL_FILES + FILE_COUNT))
        
        echo -e "${YELLOW}$((i+1)). $PKG${NC} (Versi: $VERSION) - ${GREEN}$FILE_COUNT file${NC}"
        
        if [ $DRY_RUN -eq 1 ]; then
            echo "$RAW_PATHS" | head -n 4 | while read -r path_line; do echo "     - $path_line"; done
            if [ "$FILE_COUNT" -gt 4 ]; then echo "     ... (dan $((FILE_COUNT - 4)) file lainnya)"; fi
        else
            echo "$RAW_PATHS" | head -n 2 | while read -r path_line; do echo "     - $path_line"; done
            if [ "$FILE_COUNT" -gt 2 ]; then echo "     ... (dan $((FILE_COUNT - 2)) file lainnya)"; fi
        fi
        echo ""
    done

    if [ $DRY_RUN -eq 1 ]; then
        echo -e "${CYAN}==================================================${NC}"
        echo "🛠️  SIMULASI POST-INSTALL SCRIPT (PREVIEW KODE)"
        echo -e "${CYAN}==================================================${NC}"
        
        for i in "${!VALID_PKGS[@]}"; do
            PKG="${VALID_PKGS[$i]}"
            DEB="${VALID_DEBS[$i]}"
            CTRL_TMP=$(mktemp -d "$TEMP_DIR/ctrl_XXXXXX")
            dpkg -e "$DEB" "$CTRL_TMP" 2>/dev/null
            
            if [ -f "$CTRL_TMP/postinst" ]; then
                echo -e "${GREEN}▶ Script 'postinst' untuk paket: $PKG${NC}"
                sed -i '2,$ s|/usr|'"$LOCAL_DIR"'/usr|g' "$CTRL_TMP/postinst"
                sed -i '2,$ s|/etc|'"$LOCAL_DIR"'/etc|g' "$CTRL_TMP/postinst"
                sed -i '2,$ s|/var|'"$LOCAL_DIR"'/var|g' "$CTRL_TMP/postinst"
                sed -i '2,$ s|/opt|'"$LOCAL_DIR"'/opt|g' "$CTRL_TMP/postinst"
                sed -i '2,$ s/^[[:space:]]*chown/# chown/g' "$CTRL_TMP/postinst"
                sed -i '2,$ s/^[[:space:]]*chgrp/# chgrp/g' "$CTRL_TMP/postinst"
                sed -i '2,$ s/^[[:space:]]*ldconfig/# ldconfig/g' "$CTRL_TMP/postinst"
                sed -i '2,$ s/^[[:space:]]*systemctl/# systemctl/g' "$CTRL_TMP/postinst"
                sed -i '2,$ s/^[[:space:]]*update-rc.d/# update-rc.d/g' "$CTRL_TMP/postinst"
                echo -e "--------------------------------------------------"
                cat "$CTRL_TMP/postinst" | head -n 12
                SCRIPT_LINES=$(wc -l < "$CTRL_TMP/postinst")
                if [ "$SCRIPT_LINES" -gt 12 ]; then
                    echo -e "\n${YELLOW}... (terpotong, total $SCRIPT_LINES baris script) ...${NC}"
                fi
                echo -e "--------------------------------------------------\n"
            else
                echo -e "▶ Paket ${YELLOW}$PKG${NC} tidak memiliki script postinst.\n"
            fi
            rm -rf "$CTRL_TMP"
        done
        
        echo -e "${GREEN}✅ Simulasi --dry-run selesai. Tidak ada perubahan pada sistem Anda.${NC}"
        rm -rf "$SESSION_DIR"
        exit 0
    fi
    
    # ==========================================
    # PEMBERITAHUAN & KONFIRMASI INSTALASI
    # ==========================================
    echo -e "${CYAN}==================================================${NC}"
    echo -e "${YELLOW}⚠️  PEMBERITAHUAN INSTALASI PENTING${NC}"
    echo -e "${CYAN}==================================================${NC}"
    echo -e "Jumlah Paket    : ${GREEN}${#VALID_PKGS[@]} paket${NC} (termasuk dependensi)"
    echo -e "Total Ekstraksi : ${GREEN}$TOTAL_FILES file${NC} baru"
    echo -e "Target Lokasi   : ${CYAN}$LOCAL_DIR${NC}"
    echo -e "Post-install    : Skrip konfigurasi akan disesuaikan untuk mode non-root."
    echo ""
    
    read -p "❓ Apakah Anda setuju untuk melanjutkan proses instalasi di atas? [Y/n] " CONFIRM
    
    if [[ "$CONFIRM" =~ ^[Yy]$ ]] || [[ -z "$CONFIRM" ]]; then
        echo ""
        for i in "${!VALID_PKGS[@]}"; do
            PKG="${VALID_PKGS[$i]}"
            DEB="${VALID_DEBS[$i]}"
            
            dpkg -x "$DEB" "$LOCAL_DIR/" > /dev/null 2>> "$LOG_FILE" &
            EXTRACT_PID=$!
            spinner $EXTRACT_PID "📦 Mengekstrak: $PKG"
            wait $EXTRACT_PID
            
            if [ $? -eq 0 ]; then
                VERSION=$(dpkg-deb -f "$DEB" Version)
                FORMATTED_PATHS=$(dpkg-deb -c "$DEB" | awk '$1 !~ /^d/ {print $6}' | sed "s|^\.|${LOCAL_DIR}|" | paste -sd ',' -)
                
                TRACK_FILE="$TRACKING_DIR/${PKG}.conf"
                echo "nama_paket: $PKG" > "$TRACK_FILE"
                echo "versi: $VERSION" >> "$TRACK_FILE"
                
                IS_EXPLICIT=0
                for exp_pkg in "${PACKAGES[@]}"; do
                    if [ "$exp_pkg" == "$PKG" ]; then
                        IS_EXPLICIT=1
                        break
                    fi
                done
                
                if [ $IS_EXPLICIT -eq 1 ]; then
                    echo "tipe: manual" >> "$TRACK_FILE"
                else
                    echo "tipe: auto" >> "$TRACK_FILE"
                    echo "parent: ${PACKAGES[*]}" >> "$TRACK_FILE"
                fi
                
                echo "path: [$FORMATTED_PATHS]" >> "$TRACK_FILE"

                # ---------------------------------------------------------
                # TWEAK KHUSUS APLIKASI (APP-SPECIFIC FIXES)
                # ---------------------------------------------------------
                if [[ "$PKG" == nano* ]]; then
                    # 1. Patch path absolute di dalam file nanorc yang diekstrak
                    if [ -f "$LOCAL_DIR/etc/nanorc" ]; then
                        sed -i 's|/usr/share/nano|'"$LOCAL_DIR"'/usr/share/nano|g' "$LOCAL_DIR/etc/nanorc"
                    fi
                    
                    # 2. Buat file wrapper (pembungkus) agar binary nano memaksa baca rcfile lokal
                    mkdir -p "$LOCAL_DIR/bin"
                    WRAPPER_FILE="$LOCAL_DIR/bin/nano"
                    echo '#!/bin/bash' > "$WRAPPER_FILE"
                    echo 'exec "'"$LOCAL_DIR"'/usr/bin/nano" --rcfile="'"$LOCAL_DIR"'/etc/nanorc" "$@"' >> "$WRAPPER_FILE"
                    chmod +x "$WRAPPER_FILE"
                    
                    # 3. Tambahkan wrapper ke path CSV agar ikut terhapus saat apt-local remove
                    sed -i "s|]$|,$WRAPPER_FILE]|" "$TRACK_FILE"
                    echo -e "   ${YELLOW}🔧 Tweak: Wrapper nano ditambahkan untuk mencegah error '/etc/nanorc'.${NC}"
                    log_message "App Tweak diterapkan untuk $PKG (Nanorc patch & Wrapper)."
                fi
                # ---------------------------------------------------------
                
                CTRL_TMP=$(mktemp -d "$TEMP_DIR/ctrl_XXXXXX")
                dpkg -e "$DEB" "$CTRL_TMP" 2>> "$LOG_FILE"
                
                if [ -f "$CTRL_TMP/postinst" ]; then
                    POST_SCRIPT="$POST_INSTALL_DIR/${PKG}_postinst.sh"
                    cp "$CTRL_TMP/postinst" "$POST_SCRIPT"
                    
                    sed -i '2,$ s|/usr|'"$LOCAL_DIR"'/usr|g' "$POST_SCRIPT"
                    sed -i '2,$ s|/etc|'"$LOCAL_DIR"'/etc|g' "$POST_SCRIPT"
                    sed -i '2,$ s|/var|'"$LOCAL_DIR"'/var|g' "$POST_SCRIPT"
                    sed -i '2,$ s|/opt|'"$LOCAL_DIR"'/opt|g' "$POST_SCRIPT"
                    
                    sed -i '2,$ s/^[[:space:]]*chown/# chown/g' "$POST_SCRIPT"
                    sed -i '2,$ s/^[[:space:]]*chgrp/# chgrp/g' "$POST_SCRIPT"
                    sed -i '2,$ s/^[[:space:]]*ldconfig/# ldconfig/g' "$POST_SCRIPT"
                    sed -i '2,$ s/^[[:space:]]*systemctl/# systemctl/g' "$POST_SCRIPT"
                    sed -i '2,$ s/^[[:space:]]*update-rc.d/# update-rc.d/g' "$POST_SCRIPT"

                    chmod +x "$POST_SCRIPT"
                    bash "$POST_SCRIPT" configure >> "$LOG_FILE" 2>&1
                fi
                rm -rf "$CTRL_TMP"
                
                echo -e "${GREEN}✅ Paket '$PKG' berhasil diinstal.${NC}"
            else
                echo -e "${RED}❌ Gagal mengekstrak '$PKG'.${NC}"
            fi
        done
        echo "🎉 Proses instalasi selesai!"
    else
        echo "❌ Instalasi dibatalkan."
    fi
    rm -rf "$SESSION_DIR"
    exit 0

elif [ "$COMMAND" == "remove" ]; then
    if [ ${#PACKAGES[@]} -eq 0 ]; then
        echo "❌ Harap masukkan nama paket."
        exit 1
    fi

    for PKG in "${PACKAGES[@]}"; do
        TRACK_FILE="$TRACKING_DIR/${PKG}.conf"
        if [ ! -f "$TRACK_FILE" ]; then
            echo -e "${YELLOW}⚠️ Paket '$PKG' tidak ditemukan dalam catatan lokal. Dilewati.${NC}"
            continue
        fi
        
        (
            PATHS_LINE=$(grep "^path:" "$TRACK_FILE" | head -n 1)
            PATHS_CSV=$(echo "$PATHS_LINE" | sed -n 's/.*\[\(.*\)\].*/\1/p')
            IFS=',' read -r -a paths_array <<< "$PATHS_CSV"
            for file_path in "${paths_array[@]}"; do
                if [ -f "$file_path" ] || [ -L "$file_path" ]; then
                    rm -f "$file_path"
                fi
            done
            rm -f "$TRACK_FILE"
            if [ -f "$POST_INSTALL_DIR/${PKG}_postinst.sh" ]; then
                rm -f "$POST_INSTALL_DIR/${PKG}_postinst.sh"
            fi
        ) &
        
        RM_PID=$!
        spinner $RM_PID "🗑️ Menghapus $PKG..."
        wait $RM_PID
        echo -e "${GREEN}✅ $PKG berhasil dihapus.${NC}"
    done

    declare -a ORPHANS
    if [ -d "$TRACKING_DIR" ]; then
        for conf_file in "$TRACKING_DIR"/*.conf; do
            [ -e "$conf_file" ] || continue
            if grep -q "^tipe: auto" "$conf_file"; then
                PARENTS=$(grep "^parent:" "$conf_file" | sed 's/parent: //')
                PARENT_STILL_INSTALLED=0
                
                for p in $PARENTS; do
                    if [ -f "$TRACKING_DIR/${p}.conf" ]; then
                        PARENT_STILL_INSTALLED=1
                        break
                    fi
                done
                
                if [ $PARENT_STILL_INSTALLED -eq 0 ]; then
                    ORPHAN_PKG=$(grep "^nama_paket:" "$conf_file" | sed 's/nama_paket: //')
                    ORPHANS+=("$ORPHAN_PKG")
                fi
            fi
        done
    fi

    if [ ${#ORPHANS[@]} -gt 0 ]; then
        echo ""
        echo -e "${YELLOW}📦 Paket dependensi berikut diinstal otomatis dan tidak lagi dibutuhkan:${NC}"
        echo -e "${CYAN}${ORPHANS[*]}${NC}"
        read -p "❓ Apakah Anda ingin menghapusnya sekalian? (autoremove) [Y/n] " CONFIRM_AUTO
        
        if [[ "$CONFIRM_AUTO" =~ ^[Yy]$ ]] || [[ -z "$CONFIRM_AUTO" ]]; then
            for ORPHAN in "${ORPHANS[@]}"; do
                TRACK_FILE="$TRACKING_DIR/${ORPHAN}.conf"
                if [ -f "$TRACK_FILE" ]; then
                    (
                        PATHS_LINE=$(grep "^path:" "$TRACK_FILE" | head -n 1)
                        PATHS_CSV=$(echo "$PATHS_LINE" | sed -n 's/.*\[\(.*\)\].*/\1/p')
                        IFS=',' read -r -a paths_array <<< "$PATHS_CSV"
                        for file_path in "${paths_array[@]}"; do
                            if [ -f "$file_path" ] || [ -L "$file_path" ]; then
                                rm -f "$file_path"
                            fi
                        done
                        rm -f "$TRACK_FILE"
                        if [ -f "$POST_INSTALL_DIR/${ORPHAN}_postinst.sh" ]; then
                            rm -f "$POST_INSTALL_DIR/${ORPHAN}_postinst.sh"
                        fi
                    ) &
                    RM_AUTO_PID=$!
                    spinner $RM_AUTO_PID "🗑️ Menghapus dependensi $ORPHAN..."
                    wait $RM_AUTO_PID
                    echo -e "${GREEN}✅ Dependensi $ORPHAN berhasil dihapus.${NC}"
                fi
            done
            echo "🎉 Proses autoremove selesai."
        else
            echo "⏭️ Penghapusan dependensi dilewati."
        fi
    fi

    exit 0

elif [ "$COMMAND" == "reset" ]; then
    if [ -z "$(ls -A "$TRACKING_DIR"/*.conf 2>/dev/null)" ]; then
        echo -e "${YELLOW}📭 Belum ada paket yang terinstal. Sistem sudah bersih.${NC}"
        exit 0
    fi

    TOTAL_PKGS=$(ls -1 "$TRACKING_DIR"/*.conf | wc -l)
    
    echo -e "${RED}==================================================${NC}"
    echo -e "${RED}⚠️  PERINGATAN BAHAYA (DANGER ZONE) ⚠️${NC}"
    echo -e "${RED}==================================================${NC}"
    echo -e "Anda akan menghapus SELURUH aplikasi dan dependensi"
    echo -e "yang pernah diinstal melalui apt-local."
    echo -e "Total paket yang akan dihapus: ${YELLOW}$TOTAL_PKGS paket${NC}"
    echo -e ""
    
    read -p "❓ Apakah Anda YAKIN ingin mereset semuanya? (Ketik 'RESET' untuk melanjutkan): " CONFIRM_RESET

    if [ "$CONFIRM_RESET" == "RESET" ]; then
        (
            for conf_file in "$TRACKING_DIR"/*.conf; do
                [ -e "$conf_file" ] || continue
                PKG_NAME=$(grep "^nama_paket:" "$conf_file" | sed 's/nama_paket: //')
                
                PATHS_LINE=$(grep "^path:" "$conf_file" | head -n 1)
                PATHS_CSV=$(echo "$PATHS_LINE" | sed -n 's/.*\[\(.*\)\].*/\1/p')
                IFS=',' read -r -a paths_array <<< "$PATHS_CSV"
                
                for file_path in "${paths_array[@]}"; do
                    if [ -f "$file_path" ] || [ -L "$file_path" ]; then
                        rm -f "$file_path"
                    fi
                done
                
                rm -f "$conf_file"
                if [ -f "$POST_INSTALL_DIR/${PKG_NAME}_postinst.sh" ]; then
                    rm -f "$POST_INSTALL_DIR/${PKG_NAME}_postinst.sh"
                fi
            done
        ) &
        
        RESET_PID=$!
        spinner $RESET_PID "💥 Menghapus semua paket dan membersihkan sistem..."
        wait $RESET_PID
        
        echo -e "${GREEN}✅ Semua aplikasi lokal berhasil dihapus! Sistem kembali bersih.${NC}"
        log_message "Berhasil mereset (menghapus) semua paket lokal ($TOTAL_PKGS paket)."
    else
        echo -e "${GREEN}Membatalkan reset. Sistem tetap aman.${NC}"
    fi
    exit 0

else
    echo -e "${RED}❌ Perintah '$COMMAND' tidak dikenali.${NC}"
    exit 1
fi
